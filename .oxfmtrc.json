{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"sortTailwindcss": {},
	"svelte": {},
	"ignorePatterns": [
		".DS_Store",
		"node_modules",
		"/build",
		"/.svelte-kit",
		"/package",
		".env",
