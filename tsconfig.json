{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"plugins": [
			{
				"name": "typescript-svelte-plugin"
			}
		],
		"sourceMap": true,
		"strict": true,
		"types": ["$app/types", "vitest/globals"],
		"paths": {
			"test-setup/*": ["./test-setup/*"]
		}
	},
	"include": ["src", "test-setup", "vite.config.ts", "playwright.config.ts"]
}
