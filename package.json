{
	"name": "dev-blog",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --mode test",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npx playwright test",
		"test:playwright-ui": "npx playwright test --ui",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"typesafe-i18n": "typesafe-i18n",
		"update-deps": "pnpm update --latest"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^25.9.9",
		"@typescript-eslint/eslint-plugin": "8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@vitest/coverage-istanbul": "^4.1.11",
		"dotenv": "17.3.1",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "^17.13.0",
		"jsdom": "29.0.1",
		"mdsvex": "0.12.8",
		"ol": "10.11.0",
		"postcss": "^8.5.29",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"rehype-external-links": "^3.0.0",
		"semantic-release": "^25.0.9",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-preprocess": "6.0.5",
		"tailwindcss": "^4.3.3",
		"ts-jest": "^29.4.14",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "8.3.4",
		"vite-plugin-istanbul": "8.0.0",
		"vitest": "4.1.1",
		"vitest-dom": "^0.1.1"
	},
	"type": "module"
}
