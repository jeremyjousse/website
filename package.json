{
	"name": "dev-blog",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest --mode test",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "npx playwright test",
		"test:playwright-ui": "npx playwright test --ui",
		"format": "oxfmt",
		"lint": "oxfmt --check && oxlint",
		"typesafe-i18n": "typesafe-i18n",
		"update-deps": "pnpm update --latest"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.6",
		"@vitest/coverage-istanbul": "^5.0.5",
		"dotenv": "18.0.9",
		"jsdom": "30.1.3",
		"mdsvex": "0.12.8",
		"ol": "10.11.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"postcss": "^8.5.29",
		"rehype-external-links": "^3.0.0",
		"semantic-release": "^25.0.9",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"svelte-preprocess": "6.0.5",
		"tailwindcss": "^4.3.3",
		"ts-jest": "^29.4.14",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "8.3.4",
		"vite-plugin-istanbul": "9.0.1",
		"vitest": "5.0.5",
		"vitest-dom": "^0.1.1"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
